# Optional settings for `docker compose up`. Copy to `.env` (same folder as docker-compose.yml)
# and fill in what you need. Every line can stay blank; the demo works without any of them.

# Host port the app is served on (default 8000). Change it if something else already uses 8000,
# then open http://localhost:<APP_PORT>/demo-login instead.
APP_PORT=8000

# Comma-separated. A listed email becomes admin on its first sign-in; everyone else starts as analyst.
ADMIN_EMAILS=

# Only needed for real "Sign in with Google" (the demo login at /demo-login doesn't use them).
# Create an OAuth "Web application" client in Google Cloud and add this redirect URI:
#   http://localhost:<APP_PORT>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
